# Orchestrator — per-instance configuration.
# Every value is optional; the defaults below are what you get with no env set.
# This one set of variables fully relocates an instance (fresh container, other
# user, other ports) with zero code edits. Export them in the environment that
# launches `npm run dev` / `npm start` (server.js reads them before Next boots,
# so a .env file alone is not enough for PORT/ORCH_HOSTNAME/PTY_*).

# ---- app server (server.js) ----
# Port + bind address for the single public origin (Next.js + /pty proxy).
#
# ORCH_HOSTNAME, not HOSTNAME: the generic name is injected by things that are
# not us (Fedora's /etc/profile exports the machine name to every login shell,
# Docker injects the container id), and reading it made `npm start` bind the
# wrong interface. Bare HOSTNAME is ignored entirely.
#
# The default is loopback, because a local instance is unauthenticated and hands
# out a shell — binding every interface serves that to your whole network, and
# the cross-origin gate cannot help (a LAN client just forges the Host header).
# Widen it only behind CF_ACCESS_*. The container image sets 0.0.0.0 itself.
PORT=3000
ORCH_HOSTNAME=

# ---- terminal sidecar (pty-server.js) ----
# The node-pty WebSocket sidecar. Keep it on loopback — the browser never
# connects directly; server.js proxies /pty upgrades to PTY_HOST:PTY_PORT.
PTY_PORT=3001
PTY_HOST=127.0.0.1

# ---- public origin ----
# The origin users reach the app on (e.g. https://orch.example.com behind a
# Cloudflare Tunnel / reverse proxy). The client builds its ws(s):// terminal
# URL from it. Leave empty to use the browser's own origin (window.location),
# which is correct for any single-hostname deployment.
PUBLIC_BASE_URL=

# Local mode accepts browser traffic from loopback origins by default
# (localhost, *.localhost, 127.0.0.1, ::1). PUBLIC_BASE_URL is also trusted
# automatically. To intentionally open a local-mode instance on a LAN or
# another reverse-proxy origin, list exact comma-separated http(s) origins
# here, including non-default ports. Do not use this instead of authentication
# for an internet-exposed instance.
# Example: http://192.168.1.50:3000,https://operator.internal
ORCH_ALLOWED_ORIGINS=

# Lets the pty sidecar accept connections from off-machine. It otherwise
# requires a loopback peer, since server.js proxies to it from the same host —
# a check the caller cannot forge, unlike a header. Only for a deliberately
# split app/sidecar deployment: anything that reaches the sidecar gets a shell.
ORCH_PTY_ALLOW_REMOTE=

# ---- Cloudflare Access (origin-side auth; optional) ----
# If you expose an instance to the internet behind Cloudflare Access, these make
# the ORIGIN verify the same identity (the Cf-Access-Jwt-Assertion JWT) on every
# route AND on the /pty terminal WebSocket, so reaching the port directly grants
# nothing. Enforcement is ON iff BOTH are set — leave empty for local use.
#   CF_ACCESS_TEAM_DOMAIN: team domain, e.g. your-team.cloudflareaccess.com
#   CF_ACCESS_AUD:         the Access application's aud tag (comma-separable)
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Shared secret letting health probes (Docker HEALTHCHECK, uptime monitors) read
# the service-token routes — GET /api/instance/idle, /api/version and
# /api/instance/usage, and ONLY those — without an Access JWT, via an
# `x-service-token: <value>` header. Generate with: openssl rand -hex 32
SERVICE_TOKEN=

# ---- product analytics (PostHog; optional) ----
# When POSTHOG_KEY is set the app renders the browser snippet AND emits
# server-side events (per-turn cost/tokens, project/task counts, heartbeat).
# No-ops when unset, so local/self-host runs need nothing here.
#   POSTHOG_KEY:        the project API key (phc_...). It's a write-only ingest
#                       key and safe to expose in the browser snippet.
#   POSTHOG_HOST:       ingest host, default https://us.i.posthog.com
#                       (use https://eu.i.posthog.com for the EU cloud).
#   ORCH_ACCOUNT_ID:    the distinct_id every event is keyed by. Leave blank for
#                       a standalone instance (falls back to "self-hosted").
POSTHOG_KEY=
POSTHOG_HOST=
ORCH_ACCOUNT_ID=

# ---- data locations ----
# SQLite app data (orchestrator.db) and per-task git worktrees. Both must live
# outside any project repo. Use absolute paths — `~` is NOT expanded.
# Defaults: $HOME/.zen-orchestrator and $HOME/.agent-orchestrator/worktrees.
ORCH_DB_DIR=
ORCH_WORKTREES_DIR=

# Where "New project → Clone from GitHub" puts cloned repos. Absolute path.
# Default: $HOME/projects.
ORCH_PROJECTS_DIR=

# ---- managed services ----
# Base of the deterministic per-project port block. Each project is assigned
# base + slot at creation (stored on projects.port) and that PORT is injected
# into its supervised dev/setup/test services and its PTY shell. Relocate to
# avoid clashing with the app/sidecar ports. Default: 4300.
ORCH_SERVICE_PORT_BASE=

# Per-service in-memory log ring buffer, in lines. Bounds what the supervisor
# keeps of each service's stdout/stderr for the Services drawer. Default: 1500.
ORCH_SERVICE_LOG_LINES=

# Public service hostnames (<slug>--<appHost>, e.g. calc--orch.example.com):
# set to 1 to let server.js reverse-proxy service hostnames to the local ports,
# with per-service visibility (private / shared link / public). OFF by default
# and deliberately separate from ORCH_FEATURE_SERVICES — enabling managed
# services must never expose anything publicly on its own. Requires
# PUBLIC_BASE_URL (the instance's own hostname is derived from it) plus
# wildcard DNS/TLS covering *--<that host>; without all of that, services keep
# their honest http://localhost:<port> URLs.
ORCH_SERVICE_HOSTS=

# ---- claude binary ----
# Path to the logged-in `claude` CLI (Pro/Max). Pinned because Next's server may
# run with a trimmed PATH. Default: $HOME/.local/bin/claude.
CLAUDE_CLI_PATH=

# ---- Claude on Amazon Bedrock (optional; one Claude provider per instance) ----
# Enable Bedrock, choose a region, and provide credentials through ONE normal
# AWS SDK credential-chain method. For Docker, Compose forwards these values;
# ~/.aws also persists on the home volume and the image includes the AWS CLI.
# After restart, choose Amazon Bedrock under Settings -> Agents and Verify.
CLAUDE_CODE_USE_BEDROCK=
AWS_REGION=
AWS_DEFAULT_REGION=
AWS_PROFILE=
# Bedrock API key (simplest headless/container credential):
AWS_BEARER_TOKEN_BEDROCK=
# Or temporary/static AWS credentials:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Optional non-default shared config/credential file paths:
AWS_CONFIG_FILE=
AWS_SHARED_CREDENTIALS_FILE=
# Optional routing/model controls:
ANTHROPIC_BEDROCK_BASE_URL=
ANTHROPIC_BEDROCK_REGION_PREFIX=
ANTHROPIC_BEDROCK_SERVICE_TIER=
ANTHROPIC_MODEL=
ANTHROPIC_DEFAULT_OPUS_MODEL=
ANTHROPIC_DEFAULT_SONNET_MODEL=
ANTHROPIC_DEFAULT_HAIKU_MODEL=

# ---- codex binary ----
# Path to the `codex` CLI the Codex agent driver drives (ChatGPT-plan login).
# Empty = the SDK auto-resolves the binary bundled with @openai/codex, and the
# auth helpers fall back to `codex` on PATH (installed globally in the image).
# Set to pin a specific binary when PATH is trimmed. Default: (auto-resolve).
CODEX_CLI_PATH=

# The `approval_policy` the Codex driver passes to the CLI. Default "never"
# (unattended auto-run in isolated worktrees). Enterprise-managed Codex
# deployments can disallow "never" — Operator detects the CLI's downgrade
# warning and switches itself to "on-request" from the next turn on, so
# usually nothing needs to be set here. To pick a policy up front use
# "on-request" or "on-failure", or "inherit" to omit the override so
# ~/.codex/config.toml and the managed requirements decide. Do NOT use
# "untrusted"/UnlessTrusted: Operator's non-interactive sessions can't answer
# its approval prompts, so every command is rejected (it maps to "on-request").
CODEX_APPROVAL_POLICY=

# ---- internal agent-tool bridge ----
# The loopback origin the stdio MCP bridge (scripts/orch-mcp.mjs, spawned by the
# Codex CLI per turn) uses to POST suggest_task / expose_service back to the app's
# internal endpoints. Authenticated with SERVICE_TOKEN. Empty = http://127.0.0.1
# on the app's own PORT, correct for the in-container default. Override only if
# the app is reached differently from inside the box.
ORCH_INTERNAL_BASE_URL=

# ---- agent credentials (usually NOT set here) ----
# The default, recommended path is subscription login done IN THE APP:
#   - Claude: onboarding / Settings "Connect Claude"   → login state in ~/.claude
#   - Codex:  Settings → Agents "Connect Codex" (device auth) → ~/.codex
# Both credential dirs live on the per-user home volume, so logins survive
# restarts with no env vars.
#
# The "I have an API key instead" paths persist their key to a 0600 file under
# ORCH_DB_DIR (anthropic-api-key / openai-api-key) and re-apply it to the process
# env on boot; you do NOT normally set these here.
#
# ANTHROPIC_API_KEY / ANTHROPIC_AUTH_TOKEN / OPENAI_API_KEY found in the launch
# environment are STRIPPED at boot (lib/env-keys.mjs + docker/entrypoint.sh,
# with a WARN in the log). A key inherited from a shell profile, environment.d,
# or a systemd unit would otherwise silently bill every turn per-token while
# the UI reports your subscription login. To deliberately seed a key from the
# environment for a headless/dev instance, opt in:
#   ORCH_ALLOW_API_KEY_ENV=1   keep env-provided keys; turns bill them per-token
#                              (the UI will report API-key billing)
ORCH_ALLOW_API_KEY_ENV=

# ---- per-instance resource caps (docker-compose.yml) ----
# What docker compose passes to the container runtime for THIS instance
# (--cpus / --memory). Defaults: 2 CPUs, 4g memory.
ORCH_CPUS=
ORCH_MEM=

# ---- feature flags ----
# Unset/empty keeps each flag's shipped default; an explicit value decides.
# In-progress flags default OFF; shipped flags default ON.

# PREVIEW tab (project live-URL view). Off until the remote-execution backend
# that actually runs/hosts the app and serves a real URL is in place. Set to 1
# to surface the tab in the session rail. Default: off.
ORCH_FEATURE_LIVE_PREVIEW=

# Command palette: the toolbar "Jump to project, session, or command…" search
# bar and its ⌘K / Ctrl-K shortcut. Fuzzy-jumps to any project or session and
# runs common commands. Set to 1 to enable. Default: off.
ORCH_FEATURE_OMNI_SEARCH=

# TEST-ONLY: registers the deterministic mock agent driver (lib/agents/mock/)
# in the agent registry. Set automatically by the Playwright e2e suite (see
# e2e/README.md) so turns run without a real agent CLI or login. Never set this
# on a real instance — the mock would appear in the agent picker. Default: off.
ORCH_E2E_MOCK_AGENT=

# Managed Services — the toolbar "Services" button/drawer, the Services command
# config (dev/setup/test) block in the project-context editor, and the persisted
# supervisor: registry rows survive restarts, managed dev servers auto-restart
# on boot (with orphaned process groups from a crashed server reaped first),
# and port conflicts surface as a readable error instead of a crash loop.
# Default: ON — set to 0 to disable. Public service hostnames are NOT included:
# they stay opt-in via ORCH_SERVICE_HOSTS above, so this flag alone exposes
# nothing publicly.
ORCH_FEATURE_SERVICES=
